/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://js.stripe.com https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:
  Permissions-Policy: camera=(), microphone=(), usb=(), payment=(self)

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/HydroCalc_Design_Unifie.html
  Cache-Control: no-cache, must-revalidate

/HydroCalc_QCM_Platform.html
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate
